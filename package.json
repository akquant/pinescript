{
  "name": "@quanttrade/pinescript",
  "version": "1.0.0",
  "description": "Enterprise Pine Script compiler and high-performance execution engine for QuantTrade",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quanttrade/pinescript.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "pinescript",
    "quanttrade",
    "compiler",
    "trading",
    "indicators",
    "fcom"
  ],
  "author": "QuantTrade Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "typescript": "^5.4.5",
    "vitest": "^2.1.8"
  }
}
